# ================= Glm-Flash-ig-skill configuration =================
# Copy this file to .env and fill it in. Never commit .env!

# --- Instagram connection (pick ONE mode) ---
# auto | session | graph  (auto = graph if token set, else session)
IG_MODE=auto

# Session mode: your Instagram username & password
IG_USERNAME=
IG_PASSWORD=

# Graph mode: Meta app token for a Business/Creator account (safest)
IG_ACCESS_TOKEN=
IG_BUSINESS_ID=

# --- Content engine (OPTIONAL in agent mode) ---
# Only needed for --use-api caption/idea generation. In a chat with the
# skill installed, the AI agent writes content itself — no key required.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.6

# --- Strategy ---
NICHE=general
TIMEZONE=Asia/Calcutta
LANGUAGE=english
WATERMARK=

# --- Safety (hard cap is 5 posts/day; lower is fine) ---
MAX_POSTS_PER_DAY=3
MIN_DELAY_SECONDS=30
MAX_DELAY_SECONDS=120

# --- Dashboard ---
HOST=127.0.0.1
PORT=8790
